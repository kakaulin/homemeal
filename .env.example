# База API Gateway. Хвост /get-price можно оставить — клиент его отрезает.
NEXT_PUBLIC_API_URL=https://<ВАШ_ДОМЕН_API_GATEWAY>/get-price

# Google OAuth client id (Google Identity Services), тот же, что в функции.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<ВАШ_GOOGLE_CLIENT_ID>.apps.googleusercontent.com

# Публичный каталог из Object Storage (catalog-nsk.json).
NEXT_PUBLIC_CATALOG_URL=https://storage.yandexcloud.net/<ПУБЛИЧНЫЙ_БАКЕТ>/catalog-nsk.json
